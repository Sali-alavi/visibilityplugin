    painter,
    rect,
    border_color,
    fill_color,
    line_width,
):
    painter.save()

    pen = QPen(border_color)
    pen.setWidthF(float(line_width))

    painter.setPen(pen)
    painter.setBrush(Qt.NoBrush if fill_color is None else fill_color)
    painter.drawRect(rect)

    painter.restore()


def _draw_line(
    painter,
    x1,
    y1,
    x2,
    y2,
    color,
    width,
    style,
):
    pen = QPen(color)
    pen.setWidthF(float(width))
    pen.setStyle(style)

    painter.setPen(pen)

    painter.drawLine(
        QPointF(float(x1), float(y1)),
        QPointF(float(x2), float(y2)),
    )


def _find_profile_summary(summaries, direction):
    for summary in summaries:
        if summary.get("direction") == direction:
            return summary

    return None


def _get_class_area_ha(statistics, class_value):
    for item in statistics["classes"]:
        if item["value"] == class_value:
            return item["area_ha"]

    return 0.0


def _map_value(
    value,
    source_min,
    source_max,
    target_min,
    target_max,
):
    source_range = source_max - source_min

    if abs(source_range) < 1e-12:
        return target_min + (target_max - target_min) / 2.0

    return target_min + (
        (value - source_min) / source_range
    ) * (target_max - target_min)


def _expand_axis_range(minimum, maximum, padding_fraction):
    minimum = float(minimum)
    maximum = float(maximum)

    value_range = maximum - minimum

    if abs(value_range) < 1e-12:
        padding = max(abs(minimum), 1.0) * 0.1
        return minimum - padding, maximum + padding

    padding = value_range * float(padding_fraction)

    return minimum - padding, maximum + padding


def _nice_axis_max(value):
    if value <= 0:
        return 1.0

    exponent = math.floor(math.log10(value))
    magnitude = 10.0 ** exponent
    normalized = value / magnitude

    if normalized <= 1.0:
        rounded = 1.0
    elif normalized <= 2.0:
        rounded = 2.0
    elif normalized <= 5.0:
        rounded = 5.0
    else:
        rounded = 10.0

    return rounded * magnitude


def _format_axis_number(value):
    value = float(value)
    absolute_value = abs(value)

    if absolute_value >= 100:
        return f"{value:.0f}"

    if absolute_value >= 10:
        return f"{value:.1f}"

    if absolute_value >= 1:
        return f"{value:.2f}"

    return f"{value:.3f}"


def _format_number(value, decimals):
    if value is None:
        return "-"

    try:
        return f"{float(value):.{int(decimals)}f}"
    except (TypeError, ValueError):
        return "-"


def _format_signed_number(value, decimals):
    if value is None:
        return "-"

    try:
        return f"{float(value):+.{int(decimals)}f}"
    except (TypeError, ValueError):
        return "-"

