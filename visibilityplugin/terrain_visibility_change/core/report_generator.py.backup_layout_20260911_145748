def _draw_ribbon_segments(
    painter,
    rect,
    rows,
    key,
    colors,
    x_min,
    x_max,
):
    """
    Draws merged runs instead of one stripe per sample.

    This is the main fix for the previous unreadable grey/red/blue
    vertical striping.
    """

    if not rows:
        return

    segments = []
    start_index = 0
    current_value = rows[0].get(key)

    for index in range(1, len(rows)):
        value = rows[index].get(key)

        if value != current_value:
            segments.append(
                (
                    start_index,
                    index - 1,
                    current_value,
                )
            )

            start_index = index
            current_value = value

    segments.append(
        (
            start_index,
            len(rows) - 1,
            current_value,
        )
    )

    for start_index, end_index, value in segments:
        start_distance = rows[start_index]["distance_m"]

        if end_index < len(rows) - 1:
            end_distance = rows[end_index + 1]["distance_m"]
        elif end_index > 0:
            previous_distance = rows[end_index - 1]["distance_m"]
            end_distance = (
                rows[end_index]["distance_m"]
                + (
                    rows[end_index]["distance_m"]
                    - previous_distance
                )
            )
        else:
            end_distance = rows[end_index]["distance_m"]

        left = _map_value(
            start_distance,
            x_min,
            x_max,
            rect.left(),
            rect.right(),
        )

        right = _map_value(
            end_distance,
            x_min,
            x_max,
            rect.left(),
            rect.right(),
        )

        if right < left:
            left, right = right, left

        painter.fillRect(
            QRectF(
                left,
                rect.top(),
                max(1.0, right - left),
                rect.height(),
            ),
            colors.get(
                value,
                colors.get(None),
            ),
        )


