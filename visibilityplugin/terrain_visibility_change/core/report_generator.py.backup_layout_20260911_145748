# -*- coding: utf-8 -*-

"""
PDF and CSV report generation for Surface Visibility and Viewing-Angle
Change Analyzer.

PDF structure:

Portrait:
    Page 1  - Analysis overview
    Page 2  - Visibility statistics
    Page 3  - Viewing-angle statistics and profile summary
    Page 12 - Methodology and limitations

Landscape:
    Pages 4 to 11 - One full directional profile per page:
        N, NE, E, SE, S, SW, W, NW
"""

from __future__ import annotations

import csv
import math
from pathlib import Path

import numpy
from osgeo import gdal

from qgis.PyQt.QtCore import QPointF, QRectF, Qt
from qgis.PyQt.QtGui import (
    QColor,
    QFont,
    QPainter,
    QPageLayout,
    QPageSize,
    QPdfWriter,
    QPen,
)


