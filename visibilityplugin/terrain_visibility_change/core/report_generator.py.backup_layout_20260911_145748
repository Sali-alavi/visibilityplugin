# PDF display threshold for vertical viewing-angle charts.
#
# Values below this threshold are excluded from PDF charts only.
# Raster outputs, profile CSV files and profile summary statistics
# remain unchanged.
ANGLE_CHART_MIN_DEG = -10.0


VISIBILITY_CLASSES = (
    {
        "value": 1,
        "name": "Not visible in both scenarios",
        "short_name": "Not visible in both",
        "color": QColor("#666666"),
    },
    {
        "value": 2,
        "name": "Visible in both scenarios",
        "short_name": "Visible in both",
        "color": QColor("#4C9A2A"),
    },
    {
        "value": 3,
        "name": "Visibility loss",
        "short_name": "Visibility loss",
        "color": QColor("#D73027"),
    },
    {
        "value": 4,
        "name": "Visibility gain",
        "short_name": "Visibility gain",
        "color": QColor("#2C7FB8"),
    },
)

PROFILE_DIRECTIONS = (
    "N",
    "NE",
    "E",
    "SE",
    "S",
    "SW",
    "W",
    "NW",
)


class ReportGenerationError(RuntimeError):
    """Raised when report generation fails."""


def generate_visibility_report(
    change_raster_path,
    csv_path,
    pdf_path,
    analysis_parameters,
    logo_path=None,
    profile_outputs=None,
    viewing_angle_difference_path=None,
):
    """
    Creates the visibility statistics CSV and final PDF report.
    """

    change_raster_path = Path(change_raster_path)
    csv_path = Path(csv_path)
    pdf_path = Path(pdf_path)

    if not change_raster_path.is_file():
        raise ReportGenerationError(
            "Visibility-change raster does not exist:\n"
            f"{change_raster_path}"
        )

    try:
        statistics = _calculate_visibility_statistics(
            change_raster_path
        )

        _write_visibility_statistics_csv(
            csv_path=csv_path,
            statistics=statistics,
        )

        angle_statistics = _calculate_angle_statistics(
            viewing_angle_difference_path
        )

        profile_data = _load_profile_data(
            profile_outputs
        )

        _create_pdf_report(
            pdf_path=pdf_path,
            statistics=statistics,
            angle_statistics=angle_statistics,
            analysis_parameters=analysis_parameters or {},
            logo_path=logo_path,
            profile_data=profile_data,
        )

        return statistics

    except ReportGenerationError:
        raise

    except Exception as error:
        raise ReportGenerationError(
            "Report generation failed:\n"
            f"{type(error).__name__}: {error}"
        ) from error


def _calculate_visibility_statistics(change_raster_path):
    """Calculates area and percentage statistics of visibility classes."""

    gdal.UseExceptions()

    dataset = gdal.Open(
        str(change_raster_path),
        gdal.GA_ReadOnly,
    )

    if dataset is None:
        raise ReportGenerationError(
            "Could not open visibility-change raster:\n"
            f"{change_raster_path}"
        )

    try:
        raster_band = dataset.GetRasterBand(1)

        if raster_band is None:
            raise ReportGenerationError(
                "Could not access visibility-change raster band 1."
            )

        raster_array = raster_band.ReadAsArray()

        if raster_array is None:
            raise ReportGenerationError(
                "Could not read visibility-change raster values."
            )

        geotransform = dataset.GetGeoTransform()

        if geotransform is None:
            raise ReportGenerationError(
                "Visibility-change raster has no GeoTransform."
            )

        pixel_area_m2 = abs(
            float(geotransform[1])
            * float(geotransform[5])
        )

        valid_pixel_count = int(
            numpy.count_nonzero(
                numpy.isin(
                    raster_array,
                    [1, 2, 3, 4],
                )
            )
        )

        valid_area_m2 = valid_pixel_count * pixel_area_m2

        class_statistics = []

        for class_definition in VISIBILITY_CLASSES:
            class_value = class_definition["value"]

            pixel_count = int(
                numpy.count_nonzero(
                    raster_array == class_value
                )
            )

            area_m2 = pixel_count * pixel_area_m2
            area_ha = area_m2 / 10000.0

            percentage = (
                pixel_count / valid_pixel_count * 100.0
                if valid_pixel_count > 0
                else 0.0
            )

            class_statistics.append(
                {
                    "value": class_value,
                    "name": class_definition["name"],
                    "short_name": class_definition["short_name"],
                    "color": class_definition["color"],
                    "pixel_count": pixel_count,
                    "area_m2": area_m2,
                    "area_ha": area_ha,
                    "percentage": percentage,
                }
            )

        return {
            "raster_path": str(change_raster_path),
            "pixel_area_m2": pixel_area_m2,
            "valid_pixel_count": valid_pixel_count,
            "valid_area_m2": valid_area_m2,
            "valid_area_ha": valid_area_m2 / 10000.0,
            "classes": class_statistics,
        }

    finally:
        dataset = None


def _calculate_angle_statistics(viewing_angle_difference_path):
    """Calculates global statistics for Δβ = β2230 − β2026."""

    empty_result = {
        "available": False,
        "valid_pixel_count": 0,
        "mean_deg": None,
        "min_deg": None,
        "max_deg": None,
        "negligible_area_ha": None,
        "increase_area_ha": None,
        "decrease_area_ha": None,
    }

    if not viewing_angle_difference_path:
        return empty_result

    angle_path = Path(viewing_angle_difference_path)

    if not angle_path.is_file():
        return empty_result

    dataset = gdal.Open(
        str(angle_path),
        gdal.GA_ReadOnly,
    )

    if dataset is None:
        return empty_result

    try:
        band = dataset.GetRasterBand(1)

        if band is None:
            return empty_result

        array = band.ReadAsArray()

        if array is None:
            return empty_result

        nodata_value = band.GetNoDataValue()

        valid_mask = numpy.isfinite(array)

        if nodata_value is not None:
            valid_mask &= (
                array != float(nodata_value)
            )

        values = array[valid_mask]

        if values.size == 0:
            return empty_result

        geotransform = dataset.GetGeoTransform()

        if geotransform is None:
            return empty_result

        pixel_area_m2 = abs(
            float(geotransform[1])
            * float(geotransform[5])
        )

        negligible_count = int(
            numpy.count_nonzero(
                (values >= -0.10)
                & (values <= 0.10)
            )
        )

        increase_count = int(
            numpy.count_nonzero(values > 0.25)
        )

        decrease_count = int(
            numpy.count_nonzero(values < -0.25)
        )

        return {
            "available": True,
            "valid_pixel_count": int(values.size),
            "mean_deg": float(numpy.mean(values)),
            "min_deg": float(numpy.min(values)),
            "max_deg": float(numpy.max(values)),
            "negligible_area_ha": (
                negligible_count
                * pixel_area_m2
                / 10000.0
            ),
            "increase_area_ha": (
                increase_count
                * pixel_area_m2
                / 10000.0
            ),
            "decrease_area_ha": (
                decrease_count
                * pixel_area_m2
                / 10000.0
            ),
        }

    except Exception:
        return empty_result

    finally:
        dataset = None


def _write_visibility_statistics_csv(csv_path, statistics):
    """Writes global visibility statistics CSV."""

    csv_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    with open(
        csv_path,
        "w",
        newline="",
        encoding="utf-8-sig",
    ) as csv_file:
        writer = csv.DictWriter(
            csv_file,
            fieldnames=(
                "class_value",
                "class_name",
                "pixel_count",
                "area_m2",
                "area_ha",
                "percentage_of_valid_area",
            ),
        )

        writer.writeheader()

        for item in statistics["classes"]:
            writer.writerow(
                {
                    "class_value": item["value"],
                    "class_name": item["name"],
                    "pixel_count": item["pixel_count"],
                    "area_m2": f"{item['area_m2']:.2f}",
                    "area_ha": f"{item['area_ha']:.4f}",
                    "percentage_of_valid_area": (
                        f"{item['percentage']:.4f}"
                    ),
                }
            )


def _load_profile_data(profile_outputs):
    """Loads profile summary and profile CSV files."""

    result = {
        "available": False,
        "summaries": [],
        "profiles": {},
        "sampling_interval_m": None,
        "error_message": None,
    }

    if not profile_outputs:
        result["error_message"] = (
            "Directional profile outputs were not supplied."
        )
        return result

    try:
        summary_path = Path(
            profile_outputs.get(
                "summary_path",
                "",
            )
        )

        profile_paths = profile_outputs.get(
            "profile_paths",
            {},
        )

        result["sampling_interval_m"] = (
            profile_outputs.get(
                "sampling_interval_m"
            )
        )

        if not summary_path.is_file():
            result["error_message"] = (
                "Profile summary CSV was not found."
            )
            return result

        result["summaries"] = [
            _normalize_profile_summary(row)
            for row in _read_csv_rows(summary_path)
        ]

        for direction in PROFILE_DIRECTIONS:
            profile_path_value = profile_paths.get(
                direction
            )

            if not profile_path_value:
                continue

            profile_path = Path(profile_path_value)

            if not profile_path.is_file():
                continue

            result["profiles"][direction] = [
                _normalize_profile_row(row)
                for row in _read_csv_rows(profile_path)
            ]

        result["available"] = bool(
            result["summaries"]
        )

        if not result["available"]:
            result["error_message"] = (
                "Profile summary CSV contains no profile rows."
            )

        return result

    except Exception as error:
        result["error_message"] = (
            "Could not load directional profile data: "
            f"{type(error).__name__}: {error}"
        )
        return result


def _read_csv_rows(csv_path):
    with open(
        csv_path,
        "r",
        newline="",
        encoding="utf-8-sig",
    ) as csv_file:
        return list(csv.DictReader(csv_file))


def _normalize_profile_summary(row):
    return {
        "direction": str(row.get("direction", "")).strip(),
        "azimuth_deg": _to_float(row.get("azimuth_deg")),
        "profile_length_m": _to_float(
            row.get("profile_length_m")
        ),
        "visible_length_2026_m": _to_float(
            row.get("visible_length_2026_m")
        ),
        "visible_length_2230_m": _to_float(
            row.get("visible_length_2230_m")
        ),
        "visibility_loss_length_m": _to_float(
            row.get("visibility_loss_length_m")
        ),
        "visibility_gain_length_m": _to_float(
            row.get("visibility_gain_length_m")
        ),
        "mean_surface_change_m": _to_float(
            row.get("mean_surface_change_m")
        ),
        "mean_angle_2026_deg": _to_float(
            row.get("mean_angle_2026_deg")
        ),
        "mean_angle_2230_deg": _to_float(
            row.get("mean_angle_2230_deg")
        ),
        "mean_angle_difference_deg": _to_float(
            row.get("mean_angle_difference_deg")
        ),
        "min_angle_difference_deg": _to_float(
            row.get("min_angle_difference_deg")
        ),
        "max_angle_difference_deg": _to_float(
            row.get("max_angle_difference_deg")
        ),
    }


def _normalize_profile_row(row):
    return {
        "direction": str(row.get("direction", "")).strip(),
        "distance_m": _to_float(row.get("distance_m")),
        "dom_2026_m": _to_float(row.get("dom_2026_m")),
        "dom_2230_m": _to_float(row.get("dom_2230_m")),
        "viewing_angle_2026_deg": _to_float(
            row.get("viewing_angle_2026_deg")
        ),
        "viewing_angle_2230_deg": _to_float(
            row.get("viewing_angle_2230_deg")
        ),
        "viewing_angle_difference_deg": _to_float(
            row.get("viewing_angle_difference_deg")
        ),
        "visible_2026": _to_integer(
            row.get("visible_2026")
        ),
        "visible_2230": _to_integer(
            row.get("visible_2230")
        ),
        "visibility_change_class": _to_integer(
            row.get("visibility_change_class")
        ),
    }


def _to_float(value):
    if value is None:
        return None

    text = str(value).strip()

    if not text:
        return None

    try:
        number = float(text.replace(",", "."))
        return number if math.isfinite(number) else None
    except (TypeError, ValueError):
        return None


def _to_integer(value):
    number = _to_float(value)
    return int(round(number)) if number is not None else None


def _create_pdf_report(
    pdf_path,
    statistics,
    angle_statistics,
    analysis_parameters,
    logo_path,
    profile_data,
):
    """Creates portrait summary pages and landscape profile pages."""

    pdf_path.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    writer = QPdfWriter(str(pdf_path))
    writer.setResolution(150)
    writer.setPageSize(QPageSize(QPageSize.A4))
    writer.setPageOrientation(QPageLayout.Portrait)

    writer.setTitle(
        "Surface Visibility and Viewing-Angle Change Report"
    )

    writer.setCreator(
        "IPROconsult GmbH - Surface Visibility Analyzer"
    )

    painter = QPainter()

    if not painter.begin(writer):
        raise ReportGenerationError(
            "Could not initialize PDF writer:\n"
            f"{pdf_path}"
        )

    try:
        page_rect = _get_page_rect(writer)
        content_rect = _get_content_rect(page_rect)

        _draw_page_1_overview(
            painter,
            page_rect,
            content_rect,
            analysis_parameters,
            statistics,
            logo_path,
        )

        _start_new_page(
            writer,
            QPageLayout.Portrait,
        )

        page_rect = _get_page_rect(writer)
        content_rect = _get_content_rect(page_rect)

        _draw_page_2_visibility_statistics(
            painter,
            page_rect,
            content_rect,
            statistics,
            logo_path,
        )

        _start_new_page(
            writer,
            QPageLayout.Portrait,
        )

        page_rect = _get_page_rect(writer)
        content_rect = _get_content_rect(page_rect)

        _draw_page_3_angle_and_profile_summary(
            painter,
            page_rect,
            content_rect,
            angle_statistics,
            profile_data,
            logo_path,
        )

        for index, direction in enumerate(
            PROFILE_DIRECTIONS,
            start=4,
        ):
            _start_new_page(
                writer,
                QPageLayout.Landscape,
            )

            page_rect = _get_page_rect(writer)
            content_rect = _get_content_rect(page_rect)

            _draw_landscape_profile_page(
                painter=painter,
                page_rect=page_rect,
                content_rect=content_rect,
                profile_data=profile_data,
                direction=direction,
                logo_path=logo_path,
                page_number=index,
            )

        _start_new_page(
            writer,
            QPageLayout.Portrait,
        )

        page_rect = _get_page_rect(writer)
        content_rect = _get_content_rect(page_rect)

        _draw_page_12_limitations(
            painter,
            page_rect,
            content_rect,
            logo_path,
        )

    finally:
        painter.end()


def _start_new_page(writer, orientation):
    """
    Sets orientation for the next page, then creates it.

    QPdfWriter applies the selected PageLayout to subsequently created pages.
    """

    writer.setPageOrientation(orientation)

    if not writer.newPage():
        raise ReportGenerationError(
            "Could not create a new page in PDF report."
        )


def _get_page_rect(writer):
    return QRectF(
        0.0,
        0.0,
        float(writer.width()),
        float(writer.height()),
    )


def _get_content_rect(page_rect):
    margin = 75.0

    return QRectF(
        margin,
        margin,
        page_rect.width() - 2.0 * margin,
        page_rect.height() - 2.0 * margin,
    )


def _draw_landscape_profile_page(
    painter,
    page_rect,
    content_rect,
    profile_data,
    direction,
    logo_path,
    page_number,
):
    """
    Draws one complete profile on one A4 landscape page.

    Important:
    Visibility is shown only in a dedicated three-row ribbon.
    It is NOT shown as vertical stripes behind profile lines.
    """

    summary = _find_profile_summary(
        profile_data.get("summaries", []),
        direction,
    )

    profile_rows = profile_data.get(
        "profiles",
        {},
    ).get(
        direction,
        [],
    )

    azimuth = (
        summary.get("azimuth_deg")
        if summary
        else None
    )

    _draw_page_header(
        painter=painter,
        page_rect=page_rect,
        title=(
            f"Directional Profile {direction} "
            f"(Azimuth {_format_number(azimuth, 0)}°)"
        ),
        subtitle=(
            "DOM elevation, viewing-angle comparison "
            "and geometric visibility status"
        ),
        logo_path=logo_path,
    )

    top_y = content_rect.top() + 88.0

    summary_rect = QRectF(
        content_rect.left(),
        top_y,
        content_rect.width(),
        63.0,
    )

    _draw_landscape_profile_summary(
        painter,
        summary_rect,
        summary,
    )

    elevation_rect = QRectF(
        content_rect.left(),
        summary_rect.bottom() + 19.0,
        content_rect.width(),
        255.0,
    )

    _draw_large_profile_chart(
        painter=painter,
        rect=elevation_rect,
        profile_rows=profile_rows,
        chart_type="elevation",
        title="Surface elevation profile",
        y_axis_label="DOM elevation [m]",
    )

    ribbon_rect = QRectF(
        content_rect.left(),
        elevation_rect.bottom() + 18.0,
        content_rect.width(),
        82.0,
    )

    _draw_visibility_status_ribbon(
        painter=painter,
        rect=ribbon_rect,
        profile_rows=profile_rows,
    )

    angle_rect = QRectF(
        content_rect.left(),
        ribbon_rect.bottom() + 18.0,
        content_rect.width(),
        255.0,
    )

    _draw_large_profile_chart(
        painter=painter,
        rect=angle_rect,
        profile_rows=profile_rows,
        chart_type="angle",
        title=(
            "Vertical viewing-angle profile "
            "(β2026, β2230 and Δβ)"
        ),
        y_axis_label="Vertical angle [°]",
    )

    legend_rect = QRectF(
        content_rect.left(),
        angle_rect.bottom() + 15.0,
        content_rect.width(),
        34.0,
    )

    _draw_profile_page_legend(
        painter,
        legend_rect,
    )

    _draw_page_footer(
        painter,
        page_rect,
        page_number=page_number,
        total_pages=12,
    )


def _draw_landscape_profile_summary(painter, rect, summary):
    """Draws clear large summary values for one Profile."""

    _draw_rectangle(
        painter,
        rect,
        border_color=QColor("#9AA9B5"),
        fill_color=QColor("#F5F8FA"),
        line_width=0.8,
    )

    if not summary:
        _draw_text(
            painter,
            rect,
            "No profile summary available.",
            10,
            False,
            QColor("#B30000"),
            Qt.AlignCenter,
        )
        return

    values = (
        (
            "Profile length",
            f"{_format_number(summary.get('profile_length_m'), 1)} m",
        ),
        (
            "Visible 2026",
            f"{_format_number(summary.get('visible_length_2026_m'), 1)} m",
        ),
        (
            "Visible 2230",
            f"{_format_number(summary.get('visible_length_2230_m'), 1)} m",
        ),
        (
            "Visibility loss",
            f"{_format_number(summary.get('visibility_loss_length_m'), 1)} m",
        ),
        (
            "Visibility gain",
            f"{_format_number(summary.get('visibility_gain_length_m'), 1)} m",
        ),
        (
            "Mean ΔDOM",
            f"{_format_signed_number(summary.get('mean_surface_change_m'), 2)} m",
        ),
        (
            "Mean Δβ",
            f"{_format_signed_number(summary.get('mean_angle_difference_deg'), 3)}°",
        ),
        (
            "Δβ min / max",
            (
                f"{_format_signed_number(summary.get('min_angle_difference_deg'), 3)}°"
                " / "
                f"{_format_signed_number(summary.get('max_angle_difference_deg'), 3)}°"
            ),
        ),
    )

    column_width = rect.width() / len(values)

    for index, (label, value) in enumerate(values):
        item_rect = QRectF(
            rect.left() + index * column_width,
            rect.top(),
            column_width,
            rect.height(),
        )

        if index > 0:
            _draw_line(
                painter,
                item_rect.left(),
                item_rect.top() + 7.0,
                item_rect.left(),
                item_rect.bottom() - 7.0,
                QColor("#C9D1D7"),
                0.6,
                Qt.SolidLine,
            )

        _draw_text(
            painter,
            QRectF(
                item_rect.left() + 4.0,
                item_rect.top() + 8.0,
                item_rect.width() - 8.0,
                18.0,
            ),
            label,
            8,
            False,
            QColor("#4B5563"),
            Qt.AlignHCenter | Qt.AlignVCenter,
        )

        _draw_text(
            painter,
            QRectF(
                item_rect.left() + 4.0,
                item_rect.top() + 29.0,
                item_rect.width() - 8.0,
                25.0,
            ),
            value,
            10,
            True,
            QColor("#1F2933"),
            Qt.AlignHCenter | Qt.AlignVCenter,
        )


def _draw_large_profile_chart(
    painter,
    rect,
    profile_rows,
    chart_type,
    title,
    y_axis_label,
):
    """
    Draws one large profile chart.

    For vertical viewing-angle charts, values below
    ANGLE_CHART_MIN_DEG are excluded from the PDF display only.

    Important:
    - Raster outputs remain unchanged.
    - Profile CSV files remain unchanged.
    - Profile summary statistics remain unchanged.
    - Values outside the display range create a line gap; they are not
      clipped onto the lower chart boundary.
    """

    _draw_rectangle(
        painter,
        rect,
        border_color=QColor("#A9B4BC"),
        fill_color=QColor("#FFFFFF"),
        line_width=0.8,
    )

    _draw_text(
        painter,
        QRectF(
            rect.left() + 12.0,
            rect.top() + 5.0,
            rect.width() - 24.0,
            22.0,
        ),
        title,
        11,
        True,
        QColor("#1F2933"),
        Qt.AlignLeft | Qt.AlignVCenter,
    )

    if chart_type == "elevation":
        series_definitions = (
            (
                "dom_2026_m",
                QColor("#2166AC"),
                "DOM 2026",
